{
  "name": "setup-rocm",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial GitHub Action that installs AMD ROCm / HIP SDK on Linux and Windows runners. Pick a version and GPU target, get hipcc on PATH.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "github-actions",
    "rocm",
    "amd",
    "hip",
    "gpu",
    "ci",
    "hipcc"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "package": "npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "all": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run package"
  },
  "dependencies": {
    "@actions/cache": "^6.3.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "rollup": "^4.68.3",
    "ts-jest": "^29.4.15",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
